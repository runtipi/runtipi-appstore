{
  "services": [
    {
      "name": "romarr",
      "image": "ghcr.io/blizzhacker/romarr:0.6.1",
      "isMain": true,
      "internalPort": 7878,
      "environment": [
        { "key": "PUID", "value": "1000" },
        { "key": "PGID", "value": "1000" },
        { "key": "TZ", "value": "${TZ}" },
        { "key": "LIBRARY_PATH", "value": "/roms" },
        { "key": "PROWLARR_URL", "value": "${PROWLARR_URL}" },
        { "key": "PROWLARR_API_KEY", "value": "${PROWLARR_API_KEY}" },
        { "key": "LIBRARY_KIND", "value": "${LIBRARY_KIND}" },
        { "key": "LIBRARY_URL", "value": "${LIBRARY_URL}" },
        { "key": "LIBRARY_USERNAME", "value": "${LIBRARY_USERNAME}" },
        { "key": "LIBRARY_PASSWORD", "value": "${LIBRARY_PASSWORD}" },
        { "key": "QBITTORRENT_URL", "value": "${QBITTORRENT_URL}" },
        { "key": "QBITTORRENT_USER", "value": "${QBITTORRENT_USER}" },
        { "key": "QBITTORRENT_PASS", "value": "${QBITTORRENT_PASS}" }
      ],
      "volumes": [
        {
          "hostPath": "/etc/localtime",
          "containerPath": "/etc/localtime",
          "readOnly": true
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/config"
        },
        {
          "hostPath": "${ROOT_FOLDER_HOST}/media/data/roms",
          "containerPath": "/roms"
        },
        {
          "hostPath": "${ROOT_FOLDER_HOST}/media/data/torrents",
          "containerPath": "/downloads"
        }
      ]
    }
  ],
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json"
}
