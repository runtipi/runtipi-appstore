{
  "services": [
    {
      "name": "filebrowser-quantum",
      "image": "ghcr.io/gtsteffaniak/filebrowser:2-beta",
      "isMain": true,
      "internalPort": 80,
      "volumes": [
        {
          "hostPath": "${ROOT_FOLDER_HOST}/app-data",
          "containerPath": "/runtipi/app-data"
        },
        {
          "hostPath": "${ROOT_FOLDER_HOST}/user-config",
          "containerPath": "/runtipi/user-config"
        },
        {
          "hostPath": "${ROOT_FOLDER_HOST}/media",
          "containerPath": "/runtipi//media"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/home/filebrowser/data"
        }
      ]
    }
  ],
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json"
}
