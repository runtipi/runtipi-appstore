{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "maily",
      "image": "ghcr.io/stormsia/maily:latest",
      "isMain": true,
      "internalPort": 8477,
      "environment": [
        {
          "key": "MAILY_HOST",
          "value": "0.0.0.0"
        },
        {
          "key": "MAILY_PORT",
          "value": "8477"
        },
        {
          "key": "MAILY_API_KEY",
          "value": "${MAILY_API_KEY}"
        },
        {
          "key": "MAILY_DATABASE_URL",
          "value": "sqlite+aiosqlite:////data/maily.db"
        },
        {
          "key": "MAILY_SECRET_KEY_PATH",
          "value": "/data/maily.key"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ]
    }
  ]
}
